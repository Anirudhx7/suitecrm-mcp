# SuiteCRM MCP Gateway v5.0.1 - Environment Variables
#
# Copy to .env and fill in values (for manual/dev use only).
# The installer writes env files to /etc/suitecrm-mcp/ automatically.
#
# Required vars are marked (REQUIRED). Optional vars show their default.
#
# ── Table of Contents ──────────────────────────────────────────────────────
#   1. Auth Service (auth.mjs) — runs on port 3100
#   2. Per-Entity Gateway (index.mjs) — one per CRM entity
#   3. Configurable File Paths — override default /etc/suitecrm-mcp/ paths
#   4. ACL Database (MySQL) — optional, omit to disable ACL checking
#   5. Circuit Breaker & Tuning — CRM API resilience
#   6. Shared / Redis — connection and runtime
# ────────────────────────────────────────────────────────────────────────────

# ── Section 1: Auth Service (auth.mjs, port 3100) ──────────────────────────
# Handles OAuth2/OIDC login and issues session tokens.
# One instance per deployment (shared across all entities).

AUTH0_DOMAIN=your-tenant.auth0.com                    # (REQUIRED) OIDC provider domain
AUTH0_CLIENT_ID=your-client-id                         # (REQUIRED) Auth0 application client ID
AUTH0_CLIENT_SECRET=your-client-secret                 # (REQUIRED) Auth0 application client secret
AUTH0_AUDIENCE=https://your-api-identifier             # (REQUIRED) API identifier for token validation
GATEWAY_PUBLIC_URL=https://mcp.yourdomain.com           # (REQUIRED) Public URL for OAuth redirect URI
SESSION_TTL_DAYS=30                                    # Session lifetime in days (default: 30)
# OAUTH_GROUPS_CLAIM=https://your-api-identifier/groups # JWT claim for group memberships (default: AUTH0_AUDIENCE + '/groups')

PORT=3100                                               # HTTP listen port (default: 3100)
BIND_HOST=127.0.0.1                                     # Listen address (default: 127.0.0.1)
METRICS_PORT=9091                                       # Prometheus metrics port (default: 9091)
METRICS_BIND=127.0.0.1                                  # Metrics listen address (default: 127.0.0.1)
REDIS_URL=redis://127.0.0.1:6379                        # Redis connection string (default: redis://127.0.0.1:6379)
# TRUST_PROXY=1                                          # Set to 1 when behind nginx reverse proxy


# ── Section 2: Per-Entity Gateway (index.mjs, one per entity) ──────────────
# Repeated for each entity with different SUITECRM_* values.

SUITECRM_ENDPOINT=https://crm.example.com/legacy/service/v4_1/rest.php    # (REQUIRED) CRM endpoint URL
SUITECRM_PREFIX=suitecrm_crm1                            # (REQUIRED) Log/metrics label prefix
SUITECRM_CODE=crm1                                       # Entity short code (used for Redis keys, metrics labels)
SUITECRM_API_VERSION=4                                    # API strategy: "8" = GraphQL v8, "4" = legacy v4.1 (default: 4).
                                                           #   Set to "8" for SuiteCRM v8+ with OAuth2 password grant.
# SUITECRM_CLIENT_ID=your-crm-oauth-client-id             # OAuth2 client ID for v8 password grant (REQUIRED for API v8 mode)
# SUITECRM_CLIENT_SECRET=your-crm-oauth-client-secret     # OAuth2 client secret for v8 (REQUIRED for API v8 mode)
# SUITECRM_AUTH_ENDPOINT=https://crm.example.com/oauth/token  # Override OAuth2 token endpoint (default: derived from SUITECRM_ENDPOINT)

PORT=3101                                                # HTTP listen port
BIND_HOST=127.0.0.1                                      # Listen address (default: 127.0.0.1)
METRICS_PORT=9090                                        # Prometheus metrics port (default: 9090)
METRICS_BIND=127.0.0.1                                   # Metrics listen address (default: 127.0.0.1)

AUTH0_DOMAIN=your-tenant.auth0.com                       # (REQUIRED) Must match auth service
AUTH0_AUDIENCE=https://your-api-identifier                # (REQUIRED) Must match auth service
REQUIRED_GROUP=crm1_users                                 # Auth0 group required for access (omit to skip group check)
OAUTH_GROUPS_CLAIM=https://your-api-identifier/groups     # JWT groups claim (default: AUTH0_AUDIENCE + '/groups')

# NODE_TLS_REJECT_UNAUTHORIZED=0   # WARNING: disables ALL TLS verification for outbound CRM calls
#   Only use for self-signed CRM certificates in dev/lab environments.
#   Production alternative: NODE_EXTRA_CA_CERTS=/path/to/ca-bundle.pem instead.
NODE_NO_WARNINGS=1

REDIS_URL=redis://127.0.0.1:6379                         # Redis connection string


# ── Section 3: Configurable File Paths ─────────────────────────────────────
# Override the default /etc/suitecrm-mcp/ paths. All have sensible defaults;
# only set these if you need non-standard locations.

# PROFILES_FILE=/etc/suitecrm-mcp/user-profiles.json      # User CRM credentials profile store
# SESSIONS_FILE=/etc/suitecrm-mcp/sessions.json            # Legacy file-based sessions (read at startup for migration)
# BRIDGE_SESSIONS_FILE=/etc/suitecrm-mcp/bridge-sessions.json  # Bridge auth nonce store
# CRM_HOSTS_FILE=/etc/suitecrm-mcp/crm-hosts.json          # SSH provisioning host config
# ENTITIES_FILE=/etc/suitecrm-mcp/entities.json            # Entity registry (endpoints, ports, groups)
# SSH_KEY_PATH=/etc/suitecrm-mcp/ssh-key.pem               # SSH private key for CRM provisioning


# ── Section 4: ACL Database (MySQL) ────────────────────────────────────────
# Optional. Set SUITECRM_DB_HOST to an empty value or omit entirely to
# disable ACL enforcement (the gateway will fail-open, permitting all actions).
# These vars configure a direct MySQL connection to the SuiteCRM database
# for real-time permission checks.

# SUITECRM_DB_HOST=127.0.0.1                               # ACL DB host (omit to disable ACL)
# SUITECRM_DB_PORT=3306                                    # ACL DB port (default: 3306)
# SUITECRM_DB_NAME=suitecrm                                # ACL database name
# SUITECRM_DB_USER=db_user                                 # ACL database user
# SUITECRM_DB_PASS=db_password                             # ACL database password
#
# ACL permission level constants. Defaults match standard SuiteCRM (89/79/69).
# Check modules/ACLActions/actiondefs.php (or actiondefs.override.php) on your
# SuiteCRM install — some versions or customisations use different values.
# ACL_ALLOW_ALL=89
# ACL_ALLOW_GROUP=79
# ACL_ALLOW_OWNER=69
# ACL_ALLOW_DISABLED=-98


# ── Section 5: Circuit Breaker & Tuning ────────────────────────────────────
# Resilience settings for CRM API calls. The circuit breaker opens after
# CB_THRESHOLD consecutive failures, then allows a probe after CB_RESET_MS.

# CRM_TIMEOUT_MS=30000                                     # CRM API request timeout in ms (default: 30000)
# CIRCUIT_BREAKER_THRESHOLD=5                              # App-error failures before circuit opens (default: 5)
# CIRCUIT_BREAKER_RESET_MS=60000                           # Recovery window in ms (default: 60000)
# CB_INFRA_THRESHOLD=10                                    # Infra/network failures before circuit opens — higher so transient CRM restarts don't trip it (default: 10)
# CB_PROBE_INTERVAL_MS=30000                               # Background health-probe interval while circuit is OPEN; closes it automatically on recovery (default: 30000)


# ── Section 6: Redis ───────────────────────────────────────────────────────
# Redis is the sole persistence layer for sessions, profiles, and rate limits.
# For Docker deployments, set REDIS_PASSWORD in your .env file.
# docker-compose.yml uses ${REDIS_PASSWORD:-mcp_secure_redis_pass} as the default.
# For bare-metal installs, install.py auto-generates a secure password to
# /etc/suitecrm-mcp/redis_pass and injects it into REDIS_URL automatically.

# REDIS_PASSWORD=mcp_secure_redis_pass                     # Redis auth password (Docker only)
#   Generate a secure one: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#   The password is injected into REDIS_URL for both auth and gateway services.
