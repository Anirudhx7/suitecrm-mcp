{
  "title": "SuiteCRM MCP - Fleet Overview",
  "uid": "suitecrm-mcp-fleet",
  "version": 8,
  "schemaVersion": 39,
  "tags": [
    "suitecrm",
    "fleet"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "entity",
        "label": "Entity",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(suitecrm_mcp_tool_calls_total, entity)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "hide": 0
      },
      {
        "name": "log_level",
        "label": "Log Level",
        "type": "custom",
        "query": "All : .*,Info : 30,Warn : 40,Error : 50",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": ".*"
          },
          {
            "selected": false,
            "text": "Info",
            "value": "30"
          },
          {
            "selected": false,
            "text": "Warn",
            "value": "40"
          },
          {
            "selected": false,
            "text": "Error",
            "value": "50"
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "log_search",
        "label": "Log Search",
        "type": "textbox",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "log_msg",
        "label": "Message Type",
        "type": "custom",
        "query": "All : .*,Rate Limited : rate_limit_hit,SSE Connect : sse_connected,SSE Disconnect : sse_disconnected,SSE Evicted : sse_evicted_by_reconnect,Tool Call : tool_call,Login : login,CRM Login Failed : crm_login_failed,CRM Provision Failed : crm_provision_failed,Session Reused : session_reused,Auth Failure : auth_failure",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": ".*"
          },
          {
            "selected": false,
            "text": "Rate Limited",
            "value": "rate_limit_hit"
          },
          {
            "selected": false,
            "text": "SSE Connect",
            "value": "sse_connected"
          },
          {
            "selected": false,
            "text": "SSE Disconnect",
            "value": "sse_disconnected"
          },
          {
            "selected": false,
            "text": "SSE Evicted",
            "value": "sse_evicted_by_reconnect"
          },
          {
            "selected": false,
            "text": "Tool Call",
            "value": "tool_call"
          },
          {
            "selected": false,
            "text": "Login",
            "value": "login"
          },
          {
            "selected": false,
            "text": "CRM Login Failed",
            "value": "crm_login_failed"
          },
          {
            "selected": false,
            "text": "CRM Provision Failed",
            "value": "crm_provision_failed"
          },
          {
            "selected": false,
            "text": "Session Reused",
            "value": "session_reused"
          },
          {
            "selected": false,
            "text": "Auth Failure",
            "value": "auth_failure"
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "log_user",
        "label": "User Filter",
        "type": "textbox",
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "description": "Email or sub - regex, leave as .* for all users"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Traffic",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Tool Calls / min by Entity",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (entity) (rate(suitecrm_mcp_tool_calls_total[$__rate_interval]) * 60)",
          "legendFormat": "{{entity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Health",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 4,
      "title": "Circuit Breaker State",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "suitecrm_mcp_circuit_breaker_state",
          "legendFormat": "{{entity}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "entity": "Entity",
              "Value": "State"
            },
            "indexByName": {
              "Entity": 0,
              "State": 1
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "State"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Closed",
                        "color": "green"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Half-Open",
                        "color": "yellow"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "2": {
                        "text": "Open",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 2
                    }
                  ]
                }
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": []
      }
    },
    {
      "id": 5,
      "title": "Active Connections",
      "type": "bargauge",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "suitecrm_mcp_active_connections",
          "legendFormat": "{{entity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      }
    },
    {
      "id": 6,
      "title": "Login Results (24h)",
      "type": "bargauge",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(suitecrm_mcp_auth_logins_total{result=\"success\"}[24h]))",
          "legendFormat": "success"
        },
        {
          "expr": "sum(increase(suitecrm_mcp_auth_logins_total{result=\"failure\"}[24h]))",
          "legendFormat": "failure"
        },
        {
          "expr": "sum(increase(suitecrm_mcp_auth_logins_total{result=\"reused\"}[24h]))",
          "legendFormat": "reused"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "entity": "Entity",
              "Value #A": "Profiles",
              "Value #B": "Active Sessions"
            },
            "indexByName": {
              "Entity": 0,
              "Profiles": 1,
              "Active Sessions": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "sortBy": []
      }
    },
    {
      "id": 7,
      "title": "Errors",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 8,
      "title": "Error Rate by Entity %",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (entity) (rate(suitecrm_mcp_tool_calls_total{status=\"error\"}[$__rate_interval])) / sum by (entity) (rate(suitecrm_mcp_tool_calls_total[$__rate_interval])) * 100",
          "legendFormat": "{{entity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Auth Failures / min",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (entity) (rate(suitecrm_mcp_auth_failures_total[$__rate_interval]) * 60)",
          "legendFormat": "{{entity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Logs",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Live Logs (all entities)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{job=\"suitecrm-mcp\", level=~\"$log_level\"} | json | msg =~ \"$log_msg\" |~ \"(?i)$log_user\" |~ \"(?i)$log_search\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Auth",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 13,
      "title": "Auth Service Health",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "up{job=\"suitecrm-mcp-auth\"}",
          "legendFormat": "auth"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "title": "Total Logins",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 39,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(increase(suitecrm_mcp_auth_logins_total[$__range]))",
          "legendFormat": "logins"
        }
      ],
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 15,
      "title": "Active Gateway Sessions",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 39,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "suitecrm_mcp_auth_sessions_active",
          "legendFormat": "sessions"
        }
      ],
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 16,
      "title": "Users",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 17,
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "suitecrm_mcp_auth_sessions_active",
          "legendFormat": "sessions"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "title": "Total Rate Limit Hits",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 44,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(suitecrm_mcp_rate_limited_total[$__range]))",
          "legendFormat": "hits"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "Process Health",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Service Uptime & Last Restart",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "time() - process_start_time_seconds{job=~\"suitecrm-mcp.*\"}"
        },
        {
          "refId": "B",
          "instant": true,
          "format": "table",
          "expr": "process_start_time_seconds{job=~\"suitecrm-mcp.*\"} * 1000"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "exported_entity": true,
              "entity": true
            },
            "renameByName": {
              "job": "Service",
              "Value #A": "Uptime",
              "Value #B": "Last Restart"
            },
            "indexByName": {
              "Service": 0,
              "Uptime": 1,
              "Last Restart": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last Restart"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Service",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 22,
      "title": "Heap Memory All Services",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 55,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
